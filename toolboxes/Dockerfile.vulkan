FROM registry.fedoraproject.org/fedora:44
ARG REPO=https://github.com/ggml-org/llama.cpp.git
ARG BRANCH=master
ARG LLAMA_REF=${BRANCH}
ARG BUILD_JOBS=2
RUN dnf -y --setopt=install_weak_deps=False install git-core cmake gcc-c++ ninja-build glslc vulkan-headers vulkan-loader-devel vulkan-tools mesa-vulkan-drivers spirv-headers-devel libcurl-devel openssl-devel python3 procps-ng pciutils sudo passwd && dnf clean all
WORKDIR /opt/llama.cpp
RUN git init . && git remote add origin ${REPO} && git fetch --depth 1 origin ${LLAMA_REF} && git checkout --detach FETCH_HEAD && git submodule update --init --recursive
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_RPC=ON -DGGML_VULKAN=ON -DLLAMA_BUILD_TESTS=ON -DLLAMA_BUILD_EXAMPLES=ON -DLLAMA_BUILD_SERVER=ON -DBUILD_SHARED_LIBS=OFF && cmake --build build -j ${BUILD_JOBS} && cmake --install build
RUN mkdir -p /opt/b70-provenance && rpm -qa | sort > /opt/b70-provenance/packages.txt && git rev-parse HEAD > /opt/b70-provenance/source.txt && cp build/CMakeCache.txt /opt/b70-provenance/
COPY gguf-vram-estimator.py /usr/local/bin/gguf-vram-estimator.py
RUN chmod +x /usr/local/bin/gguf-vram-estimator.py
LABEL org.opencontainers.image.source="https://github.com/kyuz0/intel-b70-ai-toolboxes"
CMD ["/bin/bash"]
