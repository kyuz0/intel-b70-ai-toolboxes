ARG BASE_IMAGE=localhost/b70-fp8-base:normalized
FROM registry.fedoraproject.org/fedora:44 AS source
RUN dnf -y install git-core && dnf clean all
WORKDIR /source
ARG LAB_REF=fddfe964dab1eac909410bf5263163dd77d19ab5
RUN git init . && git remote add origin https://github.com/steveseguin/b70-optimization-lab.git && git sparse-checkout init --no-cone && printf '%s\n' '/packages/qwen38-27b-fp8-tp1-b70/overlays/' '/LICENSE' > .git/info/sparse-checkout && git fetch --depth 1 origin ${LAB_REF} && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = "${LAB_REF}" && git rev-parse HEAD > /source/revision.txt

FROM ${BASE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends sudo passwd procps pciutils curl iproute2 libnss-myhostname dialog bash-completion libcap2-bin && rm -rf /var/lib/apt/lists/*
RUN if getent passwd ubuntu >/dev/null; then test "$(id -u ubuntu)" = 1000 && userdel -r ubuntu; fi
RUN sed -i -E 's/^(hosts:.*) dns(.*)/\1\2 dns/' /etc/nsswitch.conf
COPY --from=source /source/packages/qwen38-27b-fp8-tp1-b70/overlays/ /overlay/
COPY --from=source /source/LICENSE /opt/b70-provenance/overlay-license.txt
COPY --from=source /source/revision.txt /opt/b70-provenance/overlay-source.txt
RUN dpkg-query -W > /opt/b70-provenance/packages.txt && python3 -m pip freeze > /opt/b70-provenance/python-packages.txt && test -s /opt/draft-shortlists/shortlist-u-v1all-v2top65k.txt
ENV B70_CPU_EMBED="1"
ENV B70_FA_MULTIQ="1"
ENV B70_FA_MULTIQ_MIN_K="4096"
ENV B70_FA_VERIFY_ROWS="1"
ENV B70_GDN_CHECKPOINT="1"
ENV CCL_ATL_TRANSPORT="ofi"
ENV CCL_RECV="direct"
ENV CCL_SEND="direct"
ENV CCL_SYCL_ALLGATHERV_SIMPLE_THRESHOLD="4294967296"
ENV CCL_SYCL_ALLREDUCE_SIMPLE_THRESHOLD="4294967296"
ENV CCL_SYCL_REDUCE_SCATTER_SIMPLE_THRESHOLD="4294967296"
ENV CCL_TOPO_P2P_ACCESS="1"
ENV CCL_ZE_IPC_EXCHANGE="pidfd"
ENV FI_PROVIDER="tcp"
ENV FI_TCP_IFACE="lo"
ENV ONEAPI_DEVICE_SELECTOR="level_zero:0"
ENV PYTHONHASHSEED="0"
ENV PYTHONPATH="/overlay"
ENV PYTORCH_ALLOC_CONF="expandable_segments:True"
ENV TORCHINDUCTOR_DETERMINISTIC="1"
ENV VLLM_BATCH_INVARIANT="0"
ENV VLLM_ENABLE_INDUCTOR_COORDINATE_DESCENT_TUNING="0"
ENV VLLM_ENABLE_INDUCTOR_MAX_AUTOTUNE="0"
ENV VLLM_USE_BREAKABLE_CUDAGRAPH="0"
ENV VLLM_USE_V2_MODEL_RUNNER="0"
ENV VLLM_XPU_ALLREDUCE_HOST_WAIT="1"
ENV VLLM_XPU_COMPILE_ALLREDUCE_CUSTOM_OP="0"
ENV VLLM_XPU_DECODER_BOUNDARY_TRACE_FILE=""
ENV VLLM_XPU_DRAFT_LM_HEAD_INT4="1"
ENV VLLM_XPU_DRAFT_LM_HEAD_INT4_APPLY_ROWS="0"
ENV VLLM_XPU_DRAFT_LM_HEAD_INT4_CHUNK_ROWS="2048"
ENV VLLM_XPU_DRAFT_LM_HEAD_INT4_GROUP_SIZE="128"
ENV VLLM_XPU_DRAFT_LM_HEAD_INT4_SCALE_DTYPE="bf16"
ENV VLLM_XPU_DRAFT_LM_HEAD_SHORTLIST="/opt/draft-shortlists/shortlist-u-v1all-v2top65k.txt"
ENV VLLM_XPU_ENABLE_XPU_GRAPH="0"
ENV VLLM_XPU_FA_SERIAL_SPEC_DECODE="0"
ENV VLLM_XPU_FA_SERIAL_SPEC_NO_CAUSAL="0"
ENV VLLM_XPU_FP16_LINEAR_CLASSPAD="0"
ENV VLLM_XPU_FP16_LINEAR_CLASSPAD_MAXM="512"
ENV VLLM_XPU_FP16_LINEAR_ROWCHUNK="32"
ENV VLLM_XPU_FP8_BLOCK_W8A16="1"
ENV VLLM_XPU_FP8_PACKED_SERIAL_EXACT="0"
ENV VLLM_XPU_GDN_DETERMINISTIC_QKVZ_PREFILL="0"
ENV VLLM_XPU_GDN_ISOLATE_NORM_PREFILL_REQUESTS="0"
ENV VLLM_XPU_GDN_ISOLATE_OUTPUT_PREFILL_REQUESTS="0"
ENV VLLM_XPU_GDN_ISOLATE_PREFILL_REQUESTS="0"
ENV VLLM_XPU_GDN_ISOLATE_PROJECTION_PREFILL_REQUESTS="0"
ENV VLLM_XPU_GDN_ISOLATE_QKVZ_PREFILL_REQUESTS="0"
ENV VLLM_XPU_GDN_NATIVE_FALLBACK="1"
ENV VLLM_XPU_GDN_NATIVE_SPEC_CONV_SERIAL_EXACT="0"
ENV VLLM_XPU_GDN_NATIVE_SPEC_DELTA_SERIAL_EXACT="0"
ENV VLLM_XPU_GDN_NATIVE_SPEC_EVOLVING_METADATA_TRACE="0"
ENV VLLM_XPU_GDN_NATIVE_SPEC_METADATA_TRACE="0"
ENV VLLM_XPU_GDN_NATIVE_SPEC_MULTI_REQUEST_SPLIT="0"
ENV VLLM_XPU_GDN_NATIVE_SPEC_RECURRENT_SERIAL_EXACT="0"
ENV VLLM_XPU_GDN_PREFILL_GROUP="1"
ENV VLLM_XPU_GDN_PREFILL_INPUT_TRACE_FILE=""
ENV VLLM_XPU_GDN_PREFILL_OUTPUT_TRACE_FILE=""
ENV VLLM_XPU_GDN_PROJECTION_TRACE_FILE=""
ENV VLLM_XPU_GDN_ROW_STABLE_RMSNORM="0"
ENV VLLM_XPU_GDN_SPEC_GROUP="16"
ENV VLLM_XPU_GDN_SPEC_PERSISTENT_SCRATCH="1"
ENV VLLM_XPU_GDN_SPLIT_MIXED="1"
ENV VLLM_XPU_GDN_STATE_INPUT_TRACE_FILE=""
ENV VLLM_XPU_GEMMA_RMSNORM_TRITON="0"
ENV VLLM_XPU_ISOLATE_LAYER0_MLP_PREFILL_REQUESTS="0"
ENV VLLM_XPU_LM_HEAD_BATCH_INVARIANT="0"
ENV VLLM_XPU_LM_HEAD_BATCH_REPAIR_MARGIN="0.25"
ENV VLLM_XPU_LM_HEAD_BATCH_REPAIR_ROWS="0"
ENV VLLM_XPU_LM_HEAD_CHUNK_ROWS="0"
ENV VLLM_XPU_LM_HEAD_GLOBAL_BATCH_REPAIR_MARGIN="0"
ENV VLLM_XPU_MTP_DRAFT_EAGER="0"
ENV VLLM_XPU_MTP_SUPPRESS_BONUS_TOKEN="0"
ENV VLLM_XPU_QWEN_GEMMA_RMSNORM_BATCH_INVARIANT="0"
ENV VLLM_XPU_QWEN_GEMMA_RMSNORM_PACKED_SERIAL_EXACT="1"
ENV VLLM_XPU_RMSNORM_TRITON="0"
ENV VLLM_XPU_W4A16_DETERMINISM_PAD="0"
ENV VLLM_XPU_W4A16_DETERMINISM_PAD_HIGH="0"
ENV VLLM_XPU_W8A16_DECODE_PAD_ROWS="0"
ENV VLLM_XPU_W8A16_PAD_N_SET=""
ENV PYTHONNOUSERSITE="1"
ENV VLLM_TARGET_DEVICE="xpu"
ENV VLLM_NO_USAGE_STATS="1"
# Native vLLM/kernel binaries come from the pinned publisher image; this recipe packages its matching Python overlays.
LABEL org.opencontainers.image.source="https://github.com/kyuz0/intel-b70-ai-toolboxes"
ENTRYPOINT []
CMD ["/bin/bash"]
